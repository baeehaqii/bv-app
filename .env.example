APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── WhatsApp Notifikasi via n8n (Waha) ───────────────────────────────────────
# URL webhook n8n yang akan menerima payload { phoneNumber, message }
N8N_WEBHOOK_URL=

# Nomor WA grup utama (format internasional, tanpa +): 6281234567890
NOTIFY_WA_GROUP_MAIN=

# Penerima notifikasi per divisi (pisahkan dengan koma, tanpa spasi)
NOTIFY_INFLUENCER_PHONES=
NOTIFY_SOCIAL_MEDIA_PHONES=
NOTIFY_INFLUENCER_EMAILS=manager.kol@beyondviral.id,grup-kol@beyondviral.id
NOTIFY_SOCIAL_MEDIA_EMAILS=media.creative@beyondviral.id

# Kunci ScrapeCreators — dipakai semua service scraping KOL.
# Kosong = service melempar exception saat dibuat.
SCRAPECREATORS_API_KEY=

# AI (Laravel AI SDK) — ringkasan Campaign Summary & kartu KOL
AI_PROVIDER=gemini
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# Google Spreadsheet (Migrasi Data) — service account JSON, rahasia
# Default: storage/app/google/service-account.json (sudah di-gitignore)
# Biarkan tetap dikomentari untuk memakai path default di atas — kalau diisi
# kosong, nilai kosongnya yang menang atas default.
#GOOGLE_SERVICE_ACCOUNT=/path/absolut/ke/service-account.json
#GOOGLE_IMPERSONATE_EMAIL=akun@domain-workspace.com
